{
  "info": {
    "name": "Movies Platform API",
    "description": "Express + Prisma + PostgreSQL API for movies, actors and their roles.\n\nRun the backend first (`npm run dev` in `backend/`). \"Create movie\" and \"Create actor\" save the new id in `movieId` / `actorId`, so the Cast requests use them automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000"
    },
    {
      "key": "movieId",
      "value": "1"
    },
    {
      "key": "actorId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "API status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": []
            },
            "description": "Check that the server is running."
          }
        }
      ]
    },
    {
      "name": "Movies",
      "item": [
        {
          "name": "List movies",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/movies",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "movies"
              ]
            },
            "description": "All movies, ordered by id."
          }
        },
        {
          "name": "Get movie with cast",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/movies/{{movieId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "movies",
                "{{movieId}}"
              ]
            },
            "description": "One movie with its actors and their roles."
          }
        },
        {
          "name": "Create movie",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/movies",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "movies"
              ]
            },
            "description": "Creates a movie and saves its id in `movieId`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Interstellar\",\n  \"type\": \"Sci-Fi\",\n  \"rating\": 8.7,\n  \"director\": \"Christopher Nolan\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set(\"movieId\", pm.response.json().id);",
                  "  console.log(\"Saved movieId =\", pm.response.json().id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Update movie",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/movies/{{movieId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "movies",
                "{{movieId}}"
              ]
            },
            "description": "Send any of: title, type, rating (0-10), director.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rating\": 9\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delete movie",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/movies/{{movieId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "movies",
                "{{movieId}}"
              ]
            },
            "description": "Deletes the movie and its cast rows (204)."
          }
        }
      ]
    },
    {
      "name": "Actors",
      "item": [
        {
          "name": "List actors",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actors",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "actors"
              ]
            },
            "description": "All actors, ordered by id."
          }
        },
        {
          "name": "Get actor with movies",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actors/{{actorId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "actors",
                "{{actorId}}"
              ]
            },
            "description": "One actor with their movies and roles."
          }
        },
        {
          "name": "Create actor",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/actors",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "actors"
              ]
            },
            "description": "birthday is YYYY-MM-DD. Saves the new id in `actorId`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Cillian Murphy\",\n  \"birthday\": \"1976-05-25\",\n  \"nationality\": \"Irish\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set(\"actorId\", pm.response.json().id);",
                  "  console.log(\"Saved actorId =\", pm.response.json().id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Update actor",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/actors/{{actorId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "actors",
                "{{actorId}}"
              ]
            },
            "description": "Send any of: name, birthday, nationality.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nationality\": \"Irish\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delete actor",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actors/{{actorId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "actors",
                "{{actorId}}"
              ]
            },
            "description": "Deletes the actor and their cast rows (204)."
          }
        }
      ]
    },
    {
      "name": "Cast (actor roles in a movie)",
      "item": [
        {
          "name": "Add actor to movie",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/movies/{{movieId}}/actors",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "movies",
                "{{movieId}}",
                "actors"
              ]
            },
            "description": "Change actorId in the body to the actor you want (it must be a number). 409 if the actor is already in the movie.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"actorId\": 1,\n  \"role\": \"Cooper\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Change role",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/movies/{{movieId}}/actors/{{actorId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "movies",
                "{{movieId}}",
                "actors",
                "{{actorId}}"
              ]
            },
            "description": "Updates the role of actorId in movieId.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"Joseph Cooper\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Remove actor from movie",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/movies/{{movieId}}/actors/{{actorId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "movies",
                "{{movieId}}",
                "actors",
                "{{actorId}}"
              ]
            },
            "description": "Removes the link only; the actor and the movie stay (204)."
          }
        }
      ]
    },
    {
      "name": "Error examples",
      "item": [
        {
          "name": "400 - invalid body",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/movies",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "movies"
              ]
            },
            "description": "Missing fields and a wrong type: returns the list of invalid fields.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rating\": \"high\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "400 - rating out of range",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/movies",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "movies"
              ]
            },
            "description": "rating must be between 0 and 10.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Test\",\n  \"type\": \"Drama\",\n  \"rating\": 15,\n  \"director\": \"Someone\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "400 - invalid id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/movies/abc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "movies",
                "abc"
              ]
            },
            "description": "The id in the URL must be a positive number."
          }
        },
        {
          "name": "400 - wrong birthday format",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/actors",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "actors"
              ]
            },
            "description": "birthday must be YYYY-MM-DD.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test\",\n  \"birthday\": \"25/05/1976\",\n  \"nationality\": \"Irish\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "404 - movie not found",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/movies/999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "movies",
                "999"
              ]
            },
            "description": "No movie with this id."
          }
        },
        {
          "name": "404 - unknown route",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/directors",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "directors"
              ]
            },
            "description": "No route matches this URL."
          }
        }
      ]
    }
  ]
}
