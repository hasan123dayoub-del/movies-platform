DATABASE_URL="postgresql://movies:movies@localhost:5433/movies?schema=public"
PORT=4000

# Signs login tokens: at least 32 random characters, different in production.
# Make one with: node -e "console.log(require(\"crypto\").randomBytes(48).toString(\"base64url\"))"
JWT_SECRET="change-me-to-a-long-random-string-of-32-plus-chars"

# Optional: TMDB's "API Read Access Token" (themoviedb.org > Settings > API), for "Where to watch"
TMDB_TOKEN=""
