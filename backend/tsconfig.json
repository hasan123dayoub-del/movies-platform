{
  // Used by the editor and `npm run typecheck`: checks the API, the seed and the Prisma config.
  // `npm run build` uses tsconfig.build.json, which compiles only src/ into dist/.
  "compilerOptions": {
    // Node.js with ES modules ("type": "module" in package.json)
    "module": "nodenext",
    "target": "esnext",
    "types": ["node"],
    "noEmit": true,

    // Strict type checking
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,

    // Each file must be compilable on its own (tsx compiles file by file)
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  },
  "include": ["src", "prisma", "prisma.config.ts"]
}
